# ── Python runtime ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ── Secrets and credentials — NEVER commit ────────────────────────────────────
.env
.env.*
*.key
*.pem
*.p12
*.pfx
secrets/
credentials.json
service_account.json
*_token*
*_secret*

# ── Key material and generated output ─────────────────────────────────────────
# JSON result files may contain raw key_hex — kept local only
results/*.json
results/*.bin
results/*.key

# ── Internal tool config (Codespaces / agent / IDE) ───────────────────────────
.agents/
.claude/
.codex/
.netlify/
.idea/
.vscode/
.DS_Store
*.swp
*~

# ── Test and cache artefacts ──────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
